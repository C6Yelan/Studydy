# Compose project name must be unique when running a second installation.
COMPOSE_PROJECT_NAME=studydy
STUDYDY_PORT=4173
STUDYDY_PUBLIC_ORIGIN=http://127.0.0.1:4173
STUDYDY_SECURE_COOKIE=false
# Defaults are relative to the repository root; do not point tests at product data.
STUDYDY_DATA_DIR=./data
STUDYDY_UID=1000
STUDYDY_GID=1000

POSTGRES_DB=studydy
POSTGRES_USER=studydy
# Required: set your own password. It is passed to containers, never baked into images.
POSTGRES_PASSWORD=

# An origin only, without /v1, credentials, query or fragment.
# Can be a local server, another machine, or any compatible hosted vLLM service.
STUDYDY_SEMANTIC_BASE_URL=http://host.docker.internal:18000
VLLM_API_KEY=

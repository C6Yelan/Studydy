{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyPack",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "language": { "type": "string", "default": "zh-TW" },

    "outline": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutlineNode" },
      "default": []
    },
    "key_points": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "glossary": {
      "type": "array",
      "items": { "$ref": "#/$defs/GlossaryEntry" },
      "default": []
    },
    "quiz": {
      "type": "array",
      "items": { "$ref": "#/$defs/QuizItem" },
      "default": []
    },
    "story_nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/StoryNode" },
      "default": []
    }
  },
  "required": ["schema_version", "outline", "key_points", "glossary", "quiz", "story_nodes"],
  "additionalProperties": false,

  "$defs": {
    "OutlineNode": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutlineNode" },
          "default": []
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },

    "GlossaryEntry": {
      "type": "object",
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      },
      "required": ["term", "definition"],
      "additionalProperties": false
    },

    "QuizItem": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["mcq"] },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2,
          "maxItems": 6
        },
        "answer": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string" }
      },
      "required": ["type", "question", "options", "answer"],
      "additionalProperties": false
    },

    "StoryNode": {
      "type": "object",
      "properties": {
        "scene": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2,
          "maxItems": 6
        }
      },
      "required": ["scene", "prompt", "choices"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyPack",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "maxLength": 3
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "default": "zh-TW"
    },

    "outline": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutlineNode" },
      "maxItems": 20,
      "default": []
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      },
      "maxItems": 20,
      "default": []
    },
    "glossary": {
      "type": "array",
      "items": { "$ref": "#/$defs/GlossaryEntry" },
      "maxItems": 40,
      "default": []
    },
    "quiz": {
      "type": "array",
      "items": { "$ref": "#/$defs/QuizItem" },
      "maxItems": 20,
      "default": []
    },
    "story_nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/StoryNode" },
      "maxItems": 20,
      "default": []
    }
  },
  "required": ["schema_version", "outline", "key_points", "glossary", "quiz", "story_nodes"],
  "anyOf": [
    { "properties": { "key_points": { "minItems": 1 } } },
    { "properties": { "glossary": { "minItems": 1 } } },
    { "properties": { "quiz": { "minItems": 1 } } },
    { "properties": { "story_nodes": { "minItems": 1 } } }
  ],
  "additionalProperties": false,

  "$defs": {
    "OutlineNode": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutlineNode" },
          "maxItems": 10,
          "default": []
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },

    "GlossaryEntry": {
      "type": "object",
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "maxItems": 5,
          "default": []
        }
      },
      "required": ["term", "definition"],
      "additionalProperties": false
    },

    "QuizItem": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["mcq"] },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "answer_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": ["type", "question", "options", "answer_index"],
      "dependentRequired": {
        "explanation": ["answer_index"]
      },
      "additionalProperties": false
    },

    "StoryNode": {
      "type": "object",
      "properties": {
        "scene": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 2,
          "maxItems": 4
        }
      },
      "required": ["scene", "prompt", "choices"],
      "additionalProperties": false
    }
  }
}

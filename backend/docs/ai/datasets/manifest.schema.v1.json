{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studydy.local/schemas/manifest.schema.v1.json",
  "title": "Studydy Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "datasets"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1"
    },
    "updated_at": {
      "type": "string"
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "dataset_id",
        "allowed_use",
        "license",
        "privacy",
        "files",
        "updated_at"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "allowed_use": {
          "type": "string",
          "enum": [
            "train",
            "infer_only",
            "blocked"
          ]
        },
        "license": {
          "type": "object",
          "required": [
            "type",
            "evidence"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "privacy": {
          "type": "object",
          "required": [
            "redaction_status"
          ],
          "properties": {
            "redaction_status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "done",
                "not_required"
              ]
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file_entry"
          }
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_type",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "file_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^(TBD|[0-9a-f]{64})$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
